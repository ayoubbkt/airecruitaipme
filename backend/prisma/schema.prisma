generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  password             String
  firstName            String?
  lastName             String?
  jobTitle             String?
  departmentName       String?
  role                 UserRole             @default(STANDARD)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  aiInteractionLogs    AIInteractionLog[]
  calendarIntegrations CalendarIntegration?
  
  companiesOwned       Company[]            @relation("Owner")
  companyMemberships   CompanyMember[]
  jobHiringMembers     JobHiringMember[]
  meetingAttendees     MeetingAttendee[]     @relation("UserAttendances")
  sentMessages         Message[]             @relation("SentMessages")
  receivedMessages     Message[]             @relation("ReceivedMessages")
   meetingsOwned        Meeting[]             @relation("MeetingOrganizer")
  notifications        Notification[]
  profile              UserProfile?

  comments             Comment[]             @relation("UserComments")
  uploadedFiles        CandidateFile[]       @relation("UserUploads")
  performedActivities  Activity[]            @relation("UserActivities")
  ratings              CandidateRating[]     @relation("UserRatings")
  
   

  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Company {
  id                   String                @id @default(cuid())
  name                 String
  website              String?
  phoneNumber          String?
  description          String?
  ownerId              String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  careersPageSettings  CareersPageSetting?
  owner                User                  @relation("Owner", fields: [ownerId], references: [id])
  members              CompanyMember[]
  departments          Department[]
  jobBoardIntegrations JobBoardIntegration[]
  locations            JobLocation[]
  jobs                 Job[]
  
  questionSets         QuestionSet[]
  questions            Question[]
  ratingCardTemplates  RatingCardTemplate[]
  workflowTemplates    WorkflowTemplate[]
  messageTemplates     MessageTemplate[]     @relation("CompanyMessageTemplates")
   meetingTemplates     MeetingTemplate[]     @relation("CompanyMeetingTemplates")


  

  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

model Job {
  id                 String                 @id @default(cuid())
  title              String
  description        String
  employmentType     EmploymentType
  workType           WorkType
  salaryMin          Float?
  salaryMax          Float?
  currency           String?
  payPeriod          String?
  displaySalary      Boolean                @default(true)
  status             JobStatus              @default(DRAFT)
  jobCode            String?                @unique
  companyId          String
  departmentId       String?
  locationId         String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  jobBoards          Json?
  minYearsExperience Int?
  skills             Json?
  aiSchedulingConfig AISchedulingConfig?
  aiScreeningConfig  AIScreeningConfig?
  applicationForm    ApplicationFormField[]
  applications       Application[]
  hiringTeam         JobHiringMember[]
  jobWorkflow        JobWorkflow?
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department         Department?            @relation(fields: [departmentId], references: [id])
  location           JobLocation?           @relation(fields: [locationId], references: [id])
  meetings             Meeting[]             @relation("JobMeetings")
  @@map("jobs")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs      Job[]

  @@unique([companyId, name])
  @@map("departments")
}

model JobLocation {
  id          String   @id @default(cuid())
  address     String?
  country     String
  city        String
  stateRegion String?
  zipPostal   String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs        Job[]

  @@map("job_locations")
}

model ApplicationFormField {
  id               String          @id @default(cuid())
  jobId            String
  fieldName        String
  label            String
  fieldType        FieldType
  isRequired       Boolean         @default(false)
  isOptional       Boolean         @default(false)
  isDisabled       Boolean         @default(false)
  customQuestionId String?
  order            Int
  customQuestion   CustomQuestion? @relation(fields: [customQuestionId], references: [id])
  job              Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("application_form_fields")
}

model CustomQuestion {
  id                    String                 @id @default(cuid())
  companyId             String
  questionText          String
  responseType          ResponseType
  options               Json?
  visibility            ResponseVisibility     @default(HIRING_TEAM)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  applicationFormFields ApplicationFormField[]
  candidateAnswers      CandidateAnswer[]

  @@map("custom_questions")
}

model Candidate {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  email            String            @unique
  phoneNumber      String?
  resumeUrl        String?
  score          Int?  
  ai_screening_score    Int?     // Score de 0 à 100
  ai_screening_summary  String?  @db.Text // Résumé par l'IA
  ai_screening_pros     String?  @db.Text // Points forts identifiés
  ai_screening_cons     String?  @db.Text // Points faibles identifiés
  coverLetterText  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  applications     Application[]
  candidateAnswers CandidateAnswer[] @relation("CandidateToCandidateAnswers")
 comments       Comment[]
  files          CandidateFile[]
  activities     Activity[]
  meetings       Meeting[]
  interviewNotes InterviewNote[]
  ratings        CandidateRating[]   @relation("CandidateRatings")

  @@map("candidates")
}

model InterviewNote {
  id           String   @id @default(cuid())
  candidateId  String
  jobId        String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  candidate    Candidate @relation(fields: [candidateId], references: [id])
  // Ajoutez une relation au Job si nécessaire
}

model Application {
  id                     String            @id @default(cuid())
  jobId                  String
  candidateId            String
  appliedAt              DateTime          @default(now())
  currentStageId         String?
  status                 ApplicationStatus @default(ACTIVE)
  disqualificationReason String?
  archivedAt             DateTime?
  hiredAt                DateTime?
  source                 String?
  updatedAt              DateTime          @default(now()) @updatedAt
  createdAt              DateTime          @default(now())
  candidate              Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                    Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateAnswers       CandidateAnswer[]
  candidateRatings       CandidateRating[]
  messages               MessageThread?
  meetings             Meeting[]             @relation("ApplicationMeetings")
   currentStage    JobWorkflowStage? @relation(fields: [currentStageId], references: [id])


  @@unique([jobId, candidateId])
  @@map("applications")
}

model CandidateAnswer {
  id               String         @id @default(cuid())
  applicationId    String
  customQuestionId String
  answerText       String?
  answerFileUrl    String?
  answeredAt       DateTime       @default(now())
  candidateId      String
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate        Candidate      @relation("CandidateToCandidateAnswers", fields: [candidateId], references: [id], onDelete: Cascade)
  customQuestion   CustomQuestion @relation(fields: [customQuestionId], references: [id])

  @@map("candidate_answers")
}

model WorkflowTemplate {
  id           String                  @id @default(cuid())
  name         String
  companyId    String
  isDefault    Boolean                 @default(false)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  jobWorkflows JobWorkflow[]
  stages       WorkflowStageTemplate[]
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("workflow_templates")
}

model WorkflowStageTemplate {
  id                    String           @id @default(cuid())
  workflowTemplateId    String
  name                  String
  type                  StageType
  order                 Int
  isDefault             Boolean          @default(false)
  canBeDeleted          Boolean          @default(true)
  settings              Json?
  visibilityToReviewers Boolean          @default(false)
  workflowTemplate      WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  @@unique([workflowTemplateId, order])
  @@unique([workflowTemplateId, name])
  @@map("workflow_stage_templates")
}

model JobWorkflow {
  id                 String             @id @default(cuid())
  jobId              String             @unique
  workflowTemplateId String?
  name               String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  stages             JobWorkflowStage[]
  job                Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workflowTemplate   WorkflowTemplate?  @relation(fields: [workflowTemplateId], references: [id])

  @@map("job_workflows")
}

model JobWorkflowStage {
  id            String      @id @default(cuid())
  jobWorkflowId String
  name          String
  type          StageType
  order         Int
  settings      Json?
  jobWorkflow   JobWorkflow @relation(fields: [jobWorkflowId], references: [id], onDelete: Cascade)
  applications  Application[] 
  @@unique([jobWorkflowId, order])
  @@unique([jobWorkflowId, name])
  @@map("job_workflow_stages")
}

model JobHiringMember {
  id                  String            @id @default(cuid())
  jobId               String
  userId              String
  role                CompanyMemberRole
  isExternalRecruiter Boolean           @default(false)
  createdAt           DateTime          @default(now())
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user                User              @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
  @@map("job_hiring_members")
}

model RatingCardTemplate {
  id               String            @id @default(cuid())
  name             String
  description      String?
  companyId        String
  type             RatingCardType    @default(BASIC)
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  candidateRatings CandidateRating[]
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories       RatingCategory[]

  @@unique([companyId, name])
  @@map("rating_card_templates")
}

model RatingCategory {
  id                   String             @id @default(cuid())
  ratingCardTemplateId String
  name                 String
  description          String?
  order                Int
  categoryScores       CategoryScore[]
  ratingCardTemplate   RatingCardTemplate @relation(fields: [ratingCardTemplateId], references: [id], onDelete: Cascade)

  @@unique([ratingCardTemplateId, name])
  @@map("rating_categories")
}

model CandidateRating {
  id                   String             @id @default(cuid())
  applicationId        String
  jobWorkflowStageId   String
  raterId              String
  ratingCardTemplateId String
  overallScore         Int
  candidateId          String
  comments             String?
  submittedAt          DateTime           @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  application          Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate            Candidate @relation("CandidateRatings", fields: [candidateId], references: [id])
  rater                User      @relation("UserRatings", fields: [raterId], references: [id])
  ratingCardTemplate   RatingCardTemplate @relation(fields: [ratingCardTemplateId], references: [id])
  categoryScores       CategoryScore[]

  @@map("candidate_ratings")
}

model CategoryScore {
  id                String          @id @default(cuid())
  candidateRatingId String
  ratingCategoryId  String
  score             Int
  comments          String?
  candidateRating   CandidateRating @relation(fields: [candidateRatingId], references: [id], onDelete: Cascade)
  ratingCategory    RatingCategory  @relation(fields: [ratingCategoryId], references: [id])

  @@unique([candidateRatingId, ratingCategoryId])
  @@map("category_scores")
}

model MessageThread {
  id            String      @id @default(cuid())
  applicationId String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages      Message[]   @relation("ThreadMessages")

  @@map("message_threads")
}

model Comment {
  id            String   @id @default(cuid())
  candidateId   String
  authorId      String
  content       String   @db.Text
  visibility    CommentVisibility @default(PUBLIC)
  mentionedUsers Json    @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author        User      @relation("UserComments", fields: [authorId], references: [id])
  
  @@map("comments")
}

model CandidateFile {
  id           String   @id @default(cuid())
  candidateId  String
  fileName     String
  filePath     String
  fileType     String?
  fileSize     Int?
  visibility   FileVisibility @default(PUBLIC)
  uploadedBy   String
  createdAt    DateTime @default(now())

  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploader     User      @relation("UserUploads", fields: [uploadedBy], references: [id])
  
  @@map("candidate_files")
}

model Activity {
  id          String   @id @default(cuid())
  candidateId String
  type        ActivityType
  description String
  performedBy String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  performer   User      @relation("UserActivities", fields: [performedBy], references: [id])
  
  @@map("activities")
}

model Message {
  id           String         @id @default(cuid())
  senderId     String
  recipientId  String
  threadId     String?        // Si vous utilisez des threads
  subject      String?
  content      String         @db.Text
  type         MessageType    @default(EMAIL)
  status       MessageStatus  @default(SENT)
  scheduledFor DateTime?
  templateId   String?
  attachments  Json           @default("[]")
  createdAt    DateTime       @default(now())
  readAt       DateTime?

  sender       User           @relation("SentMessages", fields: [senderId], references: [id])
  recipient    User           @relation("ReceivedMessages", fields: [recipientId], references: [id])
  thread       MessageThread? @relation("ThreadMessages", fields: [threadId], references: [id])
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  
  @@map("messages")
}

model Meeting {
  id            String         @id @default(cuid())
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  location      String?
  videoCallLink String?
  organizerId   String
  candidateId   String?        // Nouveau
  jobId         String?
  applicationId String?
  status        MeetingStatus  @default(SCHEDULED)
  meetingTemplateId String?    // Si vous l'utilisez
  createdAt     DateTime       @default(now())

  organizer     User           @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  candidate     Candidate?     @relation(fields: [candidateId], references: [id])
  job           Job?           @relation("JobMeetings", fields: [jobId], references: [id])
  application   Application?   @relation("ApplicationMeetings", fields: [applicationId], references: [id])
  template      MeetingTemplate? @relation("TemplateMeetings", fields: [meetingTemplateId], references: [id])
  attendees     MeetingAttendee[]
  aiConfig      AINoteTakingConfig?
  
  @@map("meetings")
}

model MeetingAttendee {
  id          String         @id @default(cuid())
  meetingId   String
  userId      String?
  email       String
  name        String?
  isCandidate Boolean        @default(false)
  status      AttendeeStatus @default(PENDING)
  responseAt  DateTime?

  meeting     Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User?          @relation("UserAttendances", fields: [userId], references: [id])
  
  
  @@unique([meetingId, email])
  @@map("meeting_attendees")
}

model MeetingTemplate {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  title       String
  duration    Int
  meetingType MeetingType
  description String?
  company   Company  @relation("CompanyMeetingTemplates", fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  meetings    Meeting[] @relation("TemplateMeetings")

  @@unique([companyId, name])
  @@map("meeting_templates")
}

model CareersPageSetting {
  id                String   @id @default(cuid())
  companyId         String   @unique
  logoUrl           String?
  primaryColor      String?  @default("#007bff")
  focusColor        String?  @default("#007bff")
  hyperlinkColor    String?  @default("#007bff")
  googleAnalyticsId String?
  trackingPixelUrl  String?
  embedJobsCode     String?
  customCSS         String?
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("careers_page_settings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AIScreeningConfig {
  id        String   @id @default(cuid())
  jobId     String   @unique
  isEnabled Boolean  @default(false)
  guidance  String?
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("ai_screening_configs")
}

model AISchedulingConfig {
  id        String   @id @default(cuid())
  jobId     String   @unique
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("ai_scheduling_configs")
}

model AINoteTakingConfig {
  id        String  @id @default(cuid())
  meetingId String  @unique
  isEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CORRECTION - Pas besoin de changer, mais s'assurer que Meeting a bien aiConfig
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("ai_note_taking_configs")
}

model AIInteractionLog {
  id        String   @id @default(cuid())
  userId    String?
  inputType String
  input     String
  output    String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("ai_interaction_logs")
}

model AIBusinessPreference {
  id               String   @id @default(cuid())
  companyId        String   @unique
  businessOverview String?
  businessCulture  String?
  businessValues   String?
  businessMission  String?
  updatedAt        DateTime @updatedAt

  @@map("ai_business_preferences")
}

model AICommunicationPreference {
  id                     String   @id @default(cuid())
  companyId              String   @unique
  tone                   AITone   @default(PROFESSIONAL_FORMAL)
  blockedTeamTopics      Json?
  blockedCandidateTopics Json?
  updatedAt              DateTime @updatedAt

  @@map("ai_communication_preferences")
}

model CalendarIntegration {
  id           String           @id @default(cuid())
  userId       String           @unique
  provider     CalendarProvider
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String?
  calendarId   String?
  connectedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_integrations")
}

model JobBoardIntegration {
  id        String   @id @default(cuid())
  companyId String
  boardName String
  apiKey    String?
  config    Json?
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, boardName])
  @@map("job_board_integrations")
}

model MessageTemplate {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  subject     String
  content     String    @db.Text
  type        String    @default("EMAIL")

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company   @relation("CompanyMessageTemplates", fields: [companyId], references: [id], onDelete: Cascade)
  messages    Message[]
  
  
  @@map("message_templates")
}


model Question {
  id                    String                  @id @default(cuid())
  companyId             String
  text                  String
  responseType          String
  visibility            String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  QuestionToQuestionSet QuestionToQuestionSet[]
  options               QuestionOption[]
  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  value      String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model QuestionSet {
  id                    String                  @id @default(cuid())
  companyId             String
  name                  String
  description           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  QuestionToQuestionSet QuestionToQuestionSet[]
  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("question_sets")
}

model QuestionToQuestionSet {
  A             String
  B             String
  questions     Question    @relation(fields: [A], references: [id], onDelete: Cascade)
  question_sets QuestionSet @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_QuestionToQuestionSet_AB_pkey")
  @@index([B], map: "_QuestionToQuestionSet_B_index")
  @@map("_QuestionToQuestionSet")
}

enum UserRole {
  STANDARD
  ADMIN
  MEGA_ADMIN
  EXTERNAL_RECRUITER
}

enum CompanyMemberRole {
  RECRUITING_ADMIN
  HIRING_MANAGER
  REVIEWER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP_PAID
  INTERNSHIP_UNPAID
  TEMPORARY
  OTHER
}

enum WorkType {
  ON_SITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PUBLISHED
  INTERNAL_ONLY
  CONFIDENTIAL
  ARCHIVED
  CLOSED
}

enum FieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  FILE
  YES_NO
  DROPDOWN
  MULTIPLE_CHOICE
  NUMBER
  CUSTOM_QUESTION_REFERENCE
}

enum ResponseType {
  SHORT_TEXT
  PARAGRAPH_TEXT
  YES_NO
  DROPDOWN_LIST
  MULTIPLE_CHOICE
  NUMBER
  FILE_UPLOAD
}

enum ResponseVisibility {
  HIRING_TEAM
  HIRING_MANAGERS_AND_ABOVE
}

enum ApplicationStatus {
  ACTIVE
  DISQUALIFIED
  ARCHIVED
  HIRED
  WITHDRAWN
  LEAD
  APPLICANT
  SCREENING
  INTERVIEW
  FINAL_REVIEW
  OFFER
}

enum StageType {
  LEADS
  APPLIED
  AI_SCREENING
  REVIEW
  INTERVIEW
  BACKGROUND_CHECK
  OFFER
  HIRED
  DISQUALIFIED
  ARCHIVED
  OTHER
}

enum RatingCardType {
  BASIC
  CATEGORIZED
}

enum CommentVisibility {
  PUBLIC
  PRIVATE
  CONFIDENTIAL
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum ActivityType {
  CANDIDATE_CREATED
  CANDIDATE_UPDATED
  STAGE_CHANGE
  COMMENT_ADDED
  EMAIL_SENT
  MEETING_SCHEDULED
  FILE_UPLOADED
  FILE_DELETED
  RATING_ADDED
  AI_SCREENING
}

enum MessageType {
  EMAIL
  SMS
  INTERNAL_NOTE
}

enum MessageStatus {
  DRAFT
  SCHEDULED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
